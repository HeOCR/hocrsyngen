 ],
 "lines": [
  {
   "id": "P08_0000",
   "block": "p8_date",
   "text": "09.03.1976",
   "box": [
    520,
    567,
    1260,
    746
   ],
   "font": "Rubik-wght.ttf",
   "size_pt": 18,
   "weight": 400
  },
  {
   "id": "P08_0001",
   "block": "p8_body",
   "text": "אשר קבלו מישראל האמונה באל אחד. הנוצרים",
   "box": [
    1107,
    992,
    4441,
    1242
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0002",
   "block": "p8_body",
   "text": "מעמידים בן אדם ויולדתו בשורה אחת עם בורא שמים",
   "box": [
    672,
    1257,
    4441,
    1508
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0003",
   "block": "p8_body",
   "text": "וארץ ועקר קדשת בית תפלה בא להם מהקברות אשר",
   "box": [
    753,
    1523,
    4441,
    1774
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0004",
   "block": "p8_body",
   "text": "בסביבו ובתוכו. במאות הראשונות לאמונתם לא בנו",
   "box": [
    832,
    1789,
    4441,
    2040
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0005",
   "block": "p8_body",
   "text": "בית תפלה כי אם במקום שהיה שם קבר של איש, אשר",
   "box": [
    637,
    2055,
    4441,
    2306
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0006",
   "block": "p8_body",
   "text": "מסר את נפשו על נוצריותו, למען העמיד מזבח על",
   "box": [
    923,
    2321,
    4441,
    2572
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0007",
   "block": "p8_body",
   "text": "קברו. אחרי כן התירו להם להשתמש גם בקבר של סתם",
   "box": [
    601,
    2587,
    4441,
    2837
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0008",
   "block": "p8_body",
   "text": "כמר נכבד אצלם לבנות עליו את המזבח. ועד היום אין",
   "box": [
    656,
    2852,
    4441,
    3103
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0009",
   "block": "p8_body",
   "text": "בונים במה כי אם על קבר. גם אצל המחמדים הקברים",
   "box": [
    681,
    3118,
    4441,
    3369
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0010",
   "block": "p8_body",
   "text": "קדושים ודבקין ומערים במסגדים. ואין צריכים לאמר,",
   "box": [
    663,
    3384,
    4441,
    3635
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0011",
   "block": "p8_body",
   "text": "כי כן היה אצל כל העמים הקדמונים וביחוד במצרים,",
   "box": [
    732,
    3650,
    4441,
    3901
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0012",
   "block": "p8_body",
   "text": "אשר התפללו אל המלכים ואל יתר הגדולים אחרי מותם",
   "box": [
    609,
    3916,
    4441,
    4167
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0013",
   "block": "p8_body",
   "text": "ויבנו להם צריפים 1 והיכלות. ואצלנו לא פשתה האולת",
   "box": [
    633,
    4182,
    4441,
    4433
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0014",
   "block": "p8_body",
   "text": "הרבה בימי קדם. אמנם הנביאים מוכיחים עליה וישעיה",
   "box": [
    589,
    4447,
    4441,
    4698
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0015",
   "block": "p8_body",
   "text": "הנביא לועג למתפללים אל המתים בעד החיים. אבל אין",
   "box": [
    576,
    4713,
    4441,
    4964
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0016",
   "block": "p8_body",
   "text": "הנביאים מרבים לדבר על זה, שכנראה הרגישו תמיד",
   "box": [
    757,
    4979,
    4441,
    5230
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0017",
   "block": "p8_body",
   "text": "בישראל, כי הדרישה אל המתים היא רק מולדת חוץ.",
   "box": [
    771,
    5245,
    4441,
    5496
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  },
  {
   "id": "P08_0018",
   "block": "p8_body",
   "text": "וכל עוד שאיזו טפשות הנעשית בבית יעקב נושאת את",
   "box": [
    641,
    5511,
    4441,
    5762
   ],
   "font": "Alef-Regular.ttf",
   "size_pt": 22,
   "weight": null
  }
 ],
