 ],
 "lines": [
  {
   "id": "P12_0000",
   "block": "p12_tanakh_col1",
   "text": "וְיִפְתָּח הַגִּלְעָדִי הָיָה גִּבּוֹר חַיִל וְהוּא בֶּן־אִשָּׁה זוֹנָה וַיּוֹלֶד גִּלְעָד",
   "box": [
    2563,
    567,
    4441,
    675
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0001",
   "block": "p12_tanakh_col1",
   "text": "אֶת־יִפְתָּח׃ וַתֵּלֶד אֵשֶׁת־גִּלְעָד לוֹ בָּנִים וַיִּגְדְּלוּ בְנֵי־הָאִשָּׁה וַיְגָרְשׁוּ",
   "box": [
    2563,
    696,
    4441,
    805
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0002",
   "block": "p12_tanakh_col1",
   "text": "אֶת־יִפְתָּח וַיֹּאמְרוּ לוֹ לֹא־תִנְחַל בְּבֵית־אָבִינוּ כִּי בֶּן־אִשָּׁה אַחֶרֶת",
   "box": [
    2563,
    825,
    4441,
    934
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0003",
   "block": "p12_tanakh_col1",
   "text": "אָתָּה׃ וַיִּבְרַח יִפְתָּח מִפְּנֵי אֶחָיו וַיֵּשֶׁב בְּאֶרֶץ טוֹב וַיִּתְלַקְּטוּ אֶל־יִפְתָּח",
   "box": [
    2562,
    954,
    4441,
    1063
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0004",
   "block": "p12_tanakh_col1",
   "text": "אֲנָשִׁים רֵיקִים וַיֵּצְאוּ עִמּוֹ׃ וַיְהִי מִיָּמִים וַיִּלָּחֲמוּ בְנֵי־עַמּוֹן עִם־יִשְׂרָאֵל׃",
   "box": [
    2563,
    1083,
    4441,
    1192
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0005",
   "block": "p12_tanakh_col1",
   "text": "וַיְהִי כַּאֲשֶׁר־נִלְחֲמוּ בְנֵי־עַמּוֹן עִם־יִשְׂרָאֵל וַיֵּלְכוּ זִקְנֵי גִלְעָד לָקַחַת",
   "box": [
    2563,
    1212,
    4441,
    1321
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0006",
   "block": "p12_tanakh_col1",
   "text": "אֶת־יִפְתָּח מֵאֶרֶץ טוֹב׃ וַיֹּאמְרוּ לְיִפְתָּח לְכָה וְהָיִיתָה לָּנוּ לְקָצִין",
   "box": [
    2563,
    1342,
    4441,
    1451
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0007",
   "block": "p12_tanakh_col1",
   "text": "וְנִלָּחֲמָה בִּבְנֵי עַמּוֹן׃ וַיֹּאמֶר יִפְתָּח לְזִקְנֵי גִלְעָד הֲלֹא אַתֶּם שְׂנֵאתֶם",
   "box": [
    2562,
    1471,
    4441,
    1580
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0008",
   "block": "p12_tanakh_col1",
   "text": "אוֹתִי וַתְּגָרְשׁוּנִי מִבֵּית אָבִי וּמַדּוּעַ בָּאתֶם אֵלַי עַתָּה כַּאֲשֶׁר צַר לָכֶם׃",
   "box": [
    2563,
    1600,
    4441,
    1709
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0009",
   "block": "p12_tanakh_col1",
   "text": "וַיֹּאמְרוּ זִקְנֵי גִלְעָד אֶל־יִפְתָּח לָכֵן עַתָּה שַׁבְנוּ אֵלֶיךָ וְהָלַכְתָּ עִמָּנוּ",
   "box": [
    2563,
    1729,
    4441,
    1838
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0010",
   "block": "p12_tanakh_col1",
   "text": "וְנִלְחַמְתָּ בִּבְנֵי עַמּוֹן וְהָיִיתָ לָּנוּ לְרֹאשׁ לְכֹל יֹשְׁבֵי גִלְעָד׃ וַיֹּאמֶר יִפְתָּח",
   "box": [
    2562,
    1858,
    4441,
    1967
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0011",
   "block": "p12_tanakh_col1",
   "text": "אֶל־זִקְנֵי גִלְעָד אִם־מְשִׁיבִים אַתֶּם אוֹתִי לְהִלָּחֵם בִּבְנֵי עַמּוֹן וְנָתַן",
   "box": [
    2563,
    1987,
    4441,
    2096
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0012",
   "block": "p12_tanakh_col1",
   "text": "יְהוָה אוֹתָם לְפָנָי אָנֹכִי אֶהְיֶה לָכֶם לְרֹאשׁ׃ וַיֹּאמְרוּ זִקְנֵי־גִלְעָד",
   "box": [
    2563,
    2117,
    4441,
    2226
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0013",
   "block": "p12_tanakh_col1",
   "text": "אֶל־יִפְתָּח יְהוָה יִהְיֶה שֹׁמֵעַ בֵּינוֹתֵינוּ אִם־לֹא כִדְבָרְךָ כֵּן נַעֲשֶׂה׃ וַיֵּלֶךְ",
   "box": [
    2563,
    2246,
    4441,
    2355
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0014",
   "block": "p12_tanakh_col1",
   "text": "יִפְתָּח עִם־זִקְנֵי גִלְעָד וַיָּשִׂימוּ הָעָם אוֹתוֹ עֲלֵיהֶם לְרֹאשׁ וּלְקָצִין וַיְדַבֵּר",
   "box": [
    2563,
    2375,
    4441,
    2484
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0015",
   "block": "p12_tanakh_col1",
   "text": "יִפְתָּח אֶת־כָּל־דְּבָרָיו לִפְנֵי יְהוָה בַּמִּצְפָּה׃ וַיִּשְׁלַח יִפְתָּח מַלְאָכִים",
   "box": [
    2563,
    2504,
    4441,
    2613
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0016",
   "block": "p12_tanakh_col1",
   "text": "אֶל־מֶלֶךְ בְּנֵי־עַמּוֹן לֵאמֹר מַה־לִּי וָלָךְ כִּי־בָאתָ אֵלַי לְהִלָּחֵם בְּאַרְצִי׃",
   "box": [
    2563,
    2633,
    4441,
    2742
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0017",
   "block": "p12_tanakh_col1",
   "text": "וַיֹּאמֶר מֶלֶךְ בְּנֵי־עַמּוֹן אֶל־מַלְאֲכֵי יִפְתָּח כִּי־לָקַח יִשְׂרָאֵל אֶת־אַרְצִי",
   "box": [
    2563,
    2762,
    4441,
    2871
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0018",
   "block": "p12_tanakh_col1",
   "text": "בַּעֲלוֹתוֹ מִמִּצְרַיִם מֵאַרְנוֹן וְעַד־הַיַּבֹּק וְעַד־הַיַּרְדֵּן וְעַתָּה הָשִׁיבָה אֶתְהֶן",
   "box": [
    2562,
    2892,
    4441,
    3000
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0019",
   "block": "p12_tanakh_col1",
   "text": "בְּשָׁלוֹם׃ וַיּוֹסֶף עוֹד יִפְתָּח וַיִּשְׁלַח מַלְאָכִים אֶל־מֶלֶךְ בְּנֵי עַמּוֹן׃ וַיֹּאמֶר",
   "box": [
    2562,
    3021,
    4441,
    3130
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0020",
   "block": "p12_tanakh_col1",
   "text": "לוֹ כֹּה אָמַר יִפְתָּח לֹא־לָקַח יִשְׂרָאֵל אֶת־אֶרֶץ מוֹאָב וְאֶת־אֶרֶץ בְּנֵי",
   "box": [
    2562,
    3150,
    4441,
    3259
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0021",
   "block": "p12_tanakh_col1",
   "text": "עַמּוֹן׃ כִּי בַּעֲלוֹתָם מִמִּצְרָיִם וַיֵּלֶךְ יִשְׂרָאֵל בַּמִּדְבָּר עַד־יַם־סוּף וַיָּבֹא",
   "box": [
    2563,
    3279,
    4441,
    3388
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0022",
   "block": "p12_tanakh_col1",
   "text": "קָדֵשָׁה׃ וַיִּשְׁלַח יִשְׂרָאֵל מַלְאָכִים אֶל־מֶלֶךְ אֱדוֹם לֵאמֹר אֶעְבְּרָה־נָּא",
   "box": [
    2563,
    3408,
    4441,
    3517
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0023",
   "block": "p12_tanakh_col1",
   "text": "בְאַרְצֶךָ וְלֹא שָׁמַע מֶלֶךְ אֱדוֹם וְגַם אֶל־מֶלֶךְ מוֹאָב שָׁלַח וְלֹא אָבָה",
   "box": [
    2562,
    3537,
    4441,
    3646
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0024",
   "block": "p12_tanakh_col1",
   "text": "וַיֵּשֶׁב יִשְׂרָאֵל בְּקָדֵשׁ׃ וַיֵּלֶךְ בַּמִּדְבָּר וַיָּסָב אֶת־אֶרֶץ אֱדוֹם וְאֶת־אֶרֶץ",
   "box": [
    2563,
    3666,
    4441,
    3775
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0025",
   "block": "p12_tanakh_col1",
   "text": "מוֹאָב וַיָּבֹא מִמִּזְרַח־שֶׁמֶשׁ לְאֶרֶץ מוֹאָב וַיַּחֲנוּן בְּעֵבֶר אַרְנוֹן וְלֹא־בָאוּ",
   "box": [
    2563,
    3796,
    4441,
    3905
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0026",
   "block": "p12_tanakh_col1",
   "text": "בִּגְבוּל מוֹאָב כִּי אַרְנוֹן גְּבוּל מוֹאָב׃ וַיִּשְׁלַח יִשְׂרָאֵל מַלְאָכִים",
   "box": [
    2563,
    3925,
    4441,
    4034
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0027",
   "block": "p12_tanakh_col1",
   "text": "אֶל־סִיחוֹן מֶלֶךְ־הָאֱמֹרִי מֶלֶךְ חֶשְׁבּוֹן וַיֹּאמֶר לוֹ יִשְׂרָאֵל נַעְבְּרָה־נָּא",
   "box": [
    2563,
    4054,
    4441,
    4163
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0028",
   "block": "p12_tanakh_col1",
   "text": "בְאַרְצְךָ עַד־מְקוֹמִי׃ וְלֹא־הֶאֱמִין סִיחוֹן אֶת־יִשְׂרָאֵל עֲבֹר בִּגְבֻלוֹ",
   "box": [
    2563,
    4183,
    4441,
    4292
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0029",
   "block": "p12_tanakh_col1",
   "text": "וַיֶּאֱסֹף סִיחוֹן אֶת־כָּל־עַמּוֹ וַיַּחֲנוּ בְּיָהְצָה וַיִּלָּחֶם עִם־יִשְׂרָאֵל׃ וַיִּתֵּן",
   "box": [
    2562,
    4312,
    4441,
    4421
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0030",
   "block": "p12_tanakh_col1",
   "text": "יְהוָה אֱלֹהֵי־יִשְׂרָאֵל אֶת־סִיחוֹן וְאֶת־כָּל־עַמּוֹ בְּיַד יִשְׂרָאֵל וַיַּכּוּם וַיִּירַשׁ",
   "box": [
    2563,
    4441,
    4441,
    4550
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0031",
   "block": "p12_tanakh_col1",
   "text": "יִשְׂרָאֵל אֵת כָּל־אֶרֶץ הָאֱמֹרִי יוֹשֵׁב הָאָרֶץ הַהִיא׃ וַיִּירְשׁוּ אֵת כָּל־גְּבוּל",
   "box": [
    2562,
    4571,
    4441,
    4680
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0032",
   "block": "p12_tanakh_col1",
   "text": "הָאֱמֹרִי מֵאַרְנוֹן וְעַד־הַיַּבֹּק וּמִן־הַמִּדְבָּר וְעַד־הַיַּרְדֵּן׃ וְעַתָּה יְהוָה אֱלֹהֵי",
   "box": [
    2562,
    4700,
    4441,
    4809
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0033",
   "block": "p12_tanakh_col1",
   "text": "יִשְׂרָאֵל הוֹרִישׁ אֶת־הָאֱמֹרִי מִפְּנֵי עַמּוֹ יִשְׂרָאֵל וְאַתָּה תִּירָשֶׁנּוּ׃ הֲלֹא",
   "box": [
    2563,
    4829,
    4441,
    4938
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0034",
   "block": "p12_tanakh_col1",
   "text": "אֵת אֲשֶׁר יוֹרִישְׁךָ כְּמוֹשׁ אֱלֹהֶיךָ אוֹתוֹ תִירָשׁ וְאֵת כָּל־אֲשֶׁר הוֹרִישׁ",
   "box": [
    2562,
    4958,
    4441,
    5067
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0035",
   "block": "p12_tanakh_col1",
   "text": "יְהוָה אֱלֹהֵינוּ מִפָּנֵינוּ אוֹתוֹ נִירָשׁ׃ וְעַתָּה הֲטוֹב טוֹב אַתָּה מִבָּלָק",
   "box": [
    2562,
    5087,
    4441,
    5196
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0036",
   "block": "p12_tanakh_col1",
   "text": "בֶּן־צִפּוֹר מֶלֶךְ מוֹאָב הֲרוֹב רָב עִם־יִשְׂרָאֵל אִם־נִלְחֹם נִלְחַם בָּם׃",
   "box": [
    2563,
    5217,
    4441,
    5326
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0037",
   "block": "p12_tanakh_col1",
   "text": "בְּשֶׁבֶת יִשְׂרָאֵל בְּחֶשְׁבּוֹן וּבִבְנוֹתֶיהָ וּבְעַרְעוֹר וּבִבְנוֹתֶיהָ וּבְכָל־הֶעָרִים",
   "box": [
    2563,
    5346,
    4441,
    5455
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0038",
   "block": "p12_tanakh_col1",
   "text": "אֲשֶׁר עַל־יְדֵי אַרְנוֹן שְׁלֹשׁ מֵאוֹת שָׁנָה וּמַדּוּעַ לֹא־הִצַּלְתֶּם בָּעֵת הַהִיא׃",
   "box": [
    2563,
    5475,
    4441,
    5584
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0039",
   "block": "p12_tanakh_col1",
   "text": "וְאָנֹכִי לֹא־חָטָאתִי לָךְ וְאַתָּה עֹשֶׂה אִתִּי רָעָה לְהִלָּחֶם בִּי יִשְׁפֹּט יְהוָה",
   "box": [
    2563,
    5604,
    4441,
    5713
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0040",
   "block": "p12_tanakh_col1",
   "text": "הַשֹּׁפֵט הַיּוֹם בֵּין בְּנֵי יִשְׂרָאֵל וּבֵין בְּנֵי עַמּוֹן׃ וְלֹא שָׁמַע מֶלֶךְ בְּנֵי עַמּוֹן",
   "box": [
    2563,
    5733,
    4441,
    5842
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0041",
   "block": "p12_tanakh_col1",
   "text": "אֶל־דִּבְרֵי יִפְתָּח אֲשֶׁר שָׁלַח אֵלָיו׃ וַתְּהִי עַל־יִפְתָּח רוּחַ יְהוָה וַיַּעֲבֹר",
   "box": [
    2562,
    5862,
    4441,
    5971
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0042",
   "block": "p12_tanakh_col2",
   "text": "אֶת־הַגִּלְעָד וְאֶת־מְנַשֶּׁה וַיַּעֲבֹר אֶת־מִצְפֵּה גִלְעָד וּמִמִּצְפֵּה גִלְעָד עָבַר",
   "box": [
    520,
    567,
    2398,
    675
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0043",
   "block": "p12_tanakh_col2",
   "text": "בְּנֵי עַמּוֹן׃ וַיִּדַּר יִפְתָּח נֶדֶר לַיהוָה וַיֹּאמַר אִם־נָתוֹן תִּתֵּן אֶת־בְּנֵי עַמּוֹן",
   "box": [
    520,
    696,
    2398,
    805
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0044",
   "block": "p12_tanakh_col2",
   "text": "בְּיָדִי׃ וְהָיָה הַיּוֹצֵא אֲשֶׁר יֵצֵא מִדַּלְתֵי בֵיתִי לִקְרָאתִי בְּשׁוּבִי בְשָׁלוֹם",
   "box": [
    519,
    825,
    2398,
    934
   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0045",
   "block": "p12_tanakh_col2",
   "text": "מִבְּנֵי עַמּוֹן וְהָיָה לַיהוָה וְהַעֲלִיתִהוּ עוֹלָה׃ וַיַּעֲבֹר יִפְתָּח אֶל־בְּנֵי עַמּוֹן",
   "box": [
    520,
    954,
    2398,
