   ],
   "font": "FrankRuhlLibre-wght.ttf",
   "size_pt": 10,
   "weight": 400
  },
  {
   "id": "P12_0046",
   "block": "p12_tanakh_col2",
   "text": "לְהִלָּחֶם בָּם וַיִתְּנֵם יְהוָה בְּיָדוֹ׃ וַיַּכֵּם מֵעֲרוֹעֵר וְעַד־בּוֹאֲךָ מִנִּית",
   "box": [
    520,
    1083,
